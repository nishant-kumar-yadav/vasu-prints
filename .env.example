# Application
SITE_URL=http://localhost:3000
CATALOG_SOURCE=static
QUOTE_BACKEND=off
ALLOW_PLACEHOLDERS=true
LOG_LEVEL=info

# Database (Required when CATALOG_SOURCE=mongo or QUOTE_BACKEND=on)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vasuprint?retryWrites=true&w=majority

# Uploads & Storage (Required when QUOTE_BACKEND=on)
# UPLOAD_DIR=/srv/vasuprint/shared/uploads

# Email / SMTP (Required when QUOTE_BACKEND=on)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=quotes@vasuprint.com
# SMTP_PASS=your-app-password
# MAIL_FROM="VasuPrint <quotes@vasuprint.com>"
# QUOTE_NOTIFY_TO=admin@vasuprint.com

# Cloudflare Turnstile (Required when QUOTE_BACKEND=on)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Security (Required when QUOTE_BACKEND=on)
# IP_HASH_SALT=your-random-32-byte-hex-salt

# Admin Authentication (Required for P3 Admin)
# ADMIN_EMAIL=admin@vasuprint.com
# ADMIN_PASSWORD_HASH=$argon2id$...
# SESSION_SECRET=min-32-character-random-session-secret-key-base64
# SESSION_VERSION=1

# Cloudinary (Required for P3 Admin product image uploads)
# CLOUDINARY_CLOUD_NAME=vasuprint
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Analytics & SEO (P4)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# GOOGLE_SITE_VERIFICATION=your-google-verification-token
